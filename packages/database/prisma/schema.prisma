generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────

enum Role {
  USER
  MEMBER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  googleId     String?  @unique
  passwordHash String?
  isGuest      Boolean  @default(false)
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trades        Trade[]
  tradePlans    TradePlan[]
  executions    Execution[]
  positions     Position[]
  dailyJournals DailyJournal[]
  screenshots   Screenshot[]
  importLogs    ImportLog[]
  actionPlans   ActionPlan[]
  mistakeLogs   MistakeLog[]
  riskTemplates RiskTemplate[]
  notes         Note[]
  sharedLinks         SharedLink[]
  settings            UserSettings?
  passwordResetTokens PasswordResetToken[]
}

model UserSettings {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id])
  defaultCapital  Float   @default(500000)
  defaultRiskPct  Float   @default(1.0)
  currency        String  @default("INR")
  theme           String  @default("light")
  accentColor     String  @default("blue")
  geminiApiKey    String?
  dhanClientId    String?
  dhanAccessToken String?
  tradingStyle    String  @default("Swing Trading")
  about           String?
  avatar          String?
}

// ─── RAW DATA ───────────────────────────────────────

model RawImportData {
  id          String    @id @default(cuid())
  source      String
  rawData     Json
  fileName    String?
  importLogId String?
  importLog   ImportLog? @relation(fields: [importLogId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([importLogId])
}

model ImportLog {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  source       String
  fileName     String?
  totalRows    Int             @default(0)
  newRecords   Int             @default(0)
  duplicates   Int             @default(0)
  errors       Int             @default(0)
  errorDetails Json?
  status       String
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  rawData      RawImportData[]

  @@index([userId])
}

// ─── EXECUTIONS ─────────────────────────────────────

model Execution {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])

  fingerprint    String   @unique
  symbol         String
  exchange       String   @default("NSE")
  side           String
  quantity       Float
  executedQty    Float
  price          Float
  avgPrice       Float

  orderId        String?
  executionId    String?
  orderType      String?
  productType    String?
  orderStatus    String?

  executionTime  DateTime
  orderTime      DateTime?

  brokerage      Float?
  stt            Float?
  exchangeCharges Float?
  gst            Float?
  sebiCharges    Float?
  stampDuty      Float?
  totalCharges   Float?

  tradeId        String?
  trade          Trade?   @relation(fields: [tradeId], references: [id])

  rawImportDataId String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([symbol])
  @@index([tradeId])
  @@index([executionTime])
}

// ─── TRADES ─────────────────────────────────────────

model Trade {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])

  symbol         String
  exchange       String    @default("NSE")
  direction      String
  status         String

  totalBuyQty    Float     @default(0)
  totalSellQty   Float     @default(0)
  avgEntryPrice  Float     @default(0)
  avgExitPrice   Float?

  grossPnl       Float     @default(0)
  totalCharges   Float     @default(0)
  netPnl         Float     @default(0)
  pnlPercentage  Float     @default(0)

  isArchived     Boolean   @default(false)

  riskAmount     Float?
  rMultiple      Float?

  entryTime      DateTime
  exitTime       DateTime?
  holdingPeriodMs BigInt?

  // Journal fields
  strategy       String?
  setup          String?
  thesis         String?
  plannedEntry   Float?
  stopLoss       Float?
  target         Float?
  expectedRR     Float?
  marketCondition String?
  confidence     Int?
  reasonForEntry String?
  reasonForExit  String?
  emotionalState String?
  notes          String?
  postTradeReview String?

  tradePlanId    String?
  tradePlan      TradePlan? @relation(fields: [tradePlanId], references: [id])

  executions     Execution[]
  events         TradeEvent[]
  mistakes       TradeMistake[]
  screenshots    Screenshot[]
  tradeNotes     Note[]   @relation("TradeNotes")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([symbol])
  @@index([status])
  @@index([entryTime])
  @@index([strategy])
}

// ─── TRADE EVENTS ───────────────────────────────────

model TradeEvent {
  id          String   @id @default(cuid())
  tradeId     String
  trade       Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  type        String
  description String?
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  @@index([tradeId])
  @@index([createdAt])
}

// ─── PRE-TRADE PLANNING ────────────────────────────

model TradePlan {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])

  symbol         String
  exchange       String   @default("NSE")
  direction      String

  plannedEntry   Float
  stopLoss       Float
  target         Float
  riskAmount     Float?
  expectedRR     Float?

  strategy       String?
  setup          String?
  thesis         String?
  marketCondition String?
  confidence     Int?

  status         String   @default("PLANNED")

  actualEntry    Float?
  slippage       Float?

  trades         Trade[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([symbol])
  @@index([status])
}

// ─── POSITIONS ──────────────────────────────────────

model Position {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])

  symbol        String
  exchange      String   @default("NSE")
  quantity      Float
  avgPrice      Float
  currentPrice  Float?

  unrealizedPnl Float?
  unrealizedPct Float?

  lastUpdated   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, symbol, exchange])
  @@index([userId])
}

// ─── MISTAKES ───────────────────────────────────────

model MistakeTag {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  color       String?
  trades      TradeMistake[]
}

model TradeMistake {
  id           String     @id @default(cuid())
  tradeId      String
  trade        Trade      @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  mistakeTagId String
  mistakeTag   MistakeTag @relation(fields: [mistakeTagId], references: [id])
  notes        String?

  @@unique([tradeId, mistakeTagId])
}

model MistakeLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  title       String
  desc        String?  @db.Text
  category    String
  
  symbol      String
  direction   String
  priceIn     Float
  priceOut    Float
  impact      Float
  
  recurred    Int      @default(1)
  date        DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ─── RISK TEMPLATES ─────────────────────────────────

model RiskTemplate {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  
  name                String
  capital             Float
  maxPortfolioRiskPct Float
  defaultTradeRiskPct Float
  slippagePct         Float
  winRatePct          Float
  plannedTrades       Json?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

// ─── SCREENSHOTS ────────────────────────────────────

model Screenshot {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  tradeId  String?
  trade    Trade?   @relation(fields: [tradeId], references: [id])

  url      String
  caption  String?
  phase    String?

  createdAt DateTime @default(now())

  @@index([tradeId])
}

// ─── DAILY JOURNAL ──────────────────────────────────

model DailyJournal {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  date             DateTime

  totalPnl         Float    @default(0)
  totalTrades      Int      @default(0)
  winningTrades    Int      @default(0)
  losingTrades     Int      @default(0)

  marketNotes      String?
  preMarketPlan    String?
  postMarketReview String?
  emotionalState   String?
  lessonsLearned   String?

  aiReview         String?
  aiFocus          String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, date])
}

// ─── ACTION PLANS ───────────────────────────────────

model ActionPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
}

model SharedLink {
  id         String   @id @default(cuid())
  token      String   @unique
  targetPath String?  // Optional path restriction (e.g. "journal/cuid123")
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ─── ADMIN & FEEDBACK ───────────────────────────────

model AppFeedback {
  id          String   @id @default(cuid())
  type        String   @default("contact")
  subject     String
  body        String   @db.Text
  senderName  String
  senderEmail String
  
  severity         String?
  affectedPage     String?
  stepsToReproduce String?  @db.Text
  expectedBehavior String?  @db.Text
  actualBehavior   String?  @db.Text
  
  status      String   @default("new")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── PRICE HISTORY ───────────────────────────────────
// Stores end-of-day closing prices for symbols held in open positions.
// Used by the daily P&L performance chart to calculate mark-to-market
// gains/losses per day without calling Yahoo Finance on every request.

model PriceHistory {
  id        String   @id @default(cuid())
  symbol    String   // e.g. "ETHUSDT", "RELIANCE"
  exchange  String   // e.g. "CRYPTO", "NSE"
  date      DateTime // Midnight UTC of the trading day
  closeUSD  Float    // Closing price in native currency (USD for CRYPTO, INR for NSE)
  closeINR  Float    // Closing price converted to INR using USDINR rate of that day
  usdInrRate Float   @default(1) // USDINR rate used for conversion (1 for INR-native symbols)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, exchange, date])
  @@index([symbol, exchange])
  @@index([date])
}

// ─── ACTIVE VISITORS (LIVE PRESENCE) ────────────────

model ActiveVisitor {
  id        String   @id @default(cuid())
  sessionId String   @unique
  userId    String?
  lastSeen  DateTime @default(now())

  @@index([lastSeen])
}

// ─── NOTES ───────────────────────────────────────────

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String   @default("Untitled")
  content   Json     // Tiptap JSON format
  color     String   @default("#1a1a2e") // note card accent color

  tradeId   String?  // optional — link to a specific trade
  trade     Trade?   @relation("TradeNotes", fields: [tradeId], references: [id], onDelete: SetNull)

  isPinned  Boolean  @default(false)
  isMinimized Boolean @default(false)
  url       String?
  positionX Float?
  positionY Float?
  width     Float?
  height    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tradeId])
  @@index([updatedAt])
}
